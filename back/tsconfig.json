{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2020",
    "moduleResolution": "node16",
    "types": ["node"],
    "sourceMap": true,
    "declaration": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "isolatedModules": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
